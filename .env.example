# Copy to .env and fill in. Never commit .env.
# Every variable is validated by packages/core/src/config.ts at start-up.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
# Single-tenant MVP: the tenant used by the CLI and by API keys without a tenant.
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001

# --- Database (Supabase Postgres or local) -----------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# --- Providers: which adapter each stage uses ----------------------------------
# LLM_PROVIDER: gemini | lovable-gateway | fake
LLM_PROVIDER=fake
# GATE_EDITOR: amalia | gemini | fake   (amalia = RunPod vLLM endpoint below)
GATE_EDITOR=fake
# TTS_PROVIDER: voxcpm2-runpod | voxcpm2-http | elevenlabs | gemini-cloud-tts | fake
TTS_PROVIDER=fake
# STORAGE_PROVIDER: supabase-s3 | fs
STORAGE_PROVIDER=fs
FS_STORAGE_DIR=./out/storage

# --- Models -------------------------------------------------------------------
GEN_MODEL=gemini-2.5-pro
JUDGE_MODEL=gemini-2.5-flash
AMALIA_MODEL=amalia-llm/AMALIA-9B-0626-DPO

# --- Google Gemini (OpenAI-compatible endpoint) --------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Lovable AI Gateway (existing integration path) ----------------------------
LOVABLE_API_KEY=
LOVABLE_BASE_URL=https://ai.gateway.lovable.dev/v1

# --- RunPod -------------------------------------------------------------------
RUNPOD_API_KEY=
# Serverless vLLM endpoint serving AMALIA (worker-v1-vllm)
RUNPOD_AMALIA_ENDPOINT_ID=
# Serverless endpoint running infra/runpod/voxcpm2/handler.py
RUNPOD_VOXCPM2_ENDPOINT_ID=
# Alternative: a Pod running `vllm serve openbmb/VoxCPM2 --omni` (OpenAI /v1/audio/speech)
VOXCPM2_HTTP_BASE_URL=

# --- ElevenLabs (pt-PT failover voice) -----------------------------------------
ELEVENLABS_API_KEY=

# --- Google Cloud Text-to-Speech (Gemini-TTS, pt-PT preview) --------------------
GOOGLE_TTS_API_KEY=

# --- Supabase Storage via S3 protocol ------------------------------------------
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=eu-west-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=pipeline-artifacts

# --- Listing sources -----------------------------------------------------------
PARSEBOT_API_KEY=
PILOTERR_API_KEY=
CASAFARI_API_KEY=
CASAFARI_BASE_URL=https://api.casafari.com

# --- API ------------------------------------------------------------------------
# Static bearer key for the single-tenant MVP. Required in production; optional in development.
API_KEY=

# --- Webhooks -------------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=change-me

# --- Observability --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=imovel-em-voz
